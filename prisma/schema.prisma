generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id
  email      String?   @db.VarChar(255)
  pass       String?   @db.VarChar(255)
  nickname   String?   @db.VarChar(255)
  created_at DateTime  @default(now()) @map("created_at")
  updated_at DateTime? @updatedAt @map("updated_at")

  userBooks UserBook[]
  sentences Sentence[]
  comments  Comment[]

  @@map("user")
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  imgUrl    String?  @map("img_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userBooks UserBook[]
  sentences Sentence[]

  @@map("book")
}

model UserBook {
  id             Int      @id @default(autoincrement())
  bookId         Int      @map("book_id")
  userId         String   @map("user_id")
  pageCount      Int?     @map("page_count")
  readingMinutes Int?     @map("reading_minutes")
  sentence       String?
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // relations
  book Book @relation(fields: [bookId], references: [id])
  user User @relation(fields: [userId], references: [id])

  keywords UserBookKeyword[]

  @@index([bookId])
  @@index([userId])
  @@map("user_book")
}

model Keyword {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  userBooks UserBookKeyword[]

  @@map("keyword")
}

model UserBookKeyword {
  id         Int @id @default(autoincrement())
  userBookId Int @map("user_book_id")
  keywordId  Int @map("keyword_id")

  userBook UserBook @relation(fields: [userBookId], references: [id])
  keyword  Keyword  @relation(fields: [keywordId], references: [id])

  @@unique([userBookId, keywordId]) // 동일 키워드 중복 선택 방지
  @@map("user_book_keyword")
}

model Sentence {
  id      Int     @id @default(autoincrement())
  bookId  Int     @map("book_id")
  userId  String  @map("user_id")
  content String?

  // relations
  book     Book      @relation(fields: [bookId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  comments Comment[]

  @@index([bookId])
  @@index([userId])
  @@map("sentence")
}

model Comment {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  sentenceId Int      @map("sentence_id")
  content    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // relations
  user     User     @relation(fields: [userId], references: [id])
  sentence Sentence @relation(fields: [sentenceId], references: [id])

  @@index([userId])
  @@index([sentenceId])
  @@map("comment")
}
