generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id
  email      String?  @db.VarChar(255)
  pass       String?  @db.VarChar(255)
  nickname   String?  @db.VarChar(255)
  created_at DateTime  @default(now()) @map("created_at")
  updated_at DateTime? @updatedAt  @map("updated_at")

  userBooks UserBook[]
  @@map("user")
}

model Book {
  id        Int       @id @default(autoincrement())
  title     String
  author    String
  imgUrl    String?   @map("img_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  userBooks UserBook[]

  @@map("book")  
}

model UserBook {
  id            Int       @id @default(autoincrement())
  bookId        Int       @map("book_id")
  userId        String       @map("user_id")
  pageCount     Int?      @map("page_count")
  readingMinutes Int?     @map("reading_minutes")
  sentence      String?
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  // relations
  book Book @relation(fields: [bookId], references: [id])
  user User @relation(fields: [userId], references: [id])

  keywords UserBookKeyword[]

  @@map("user_book")
  @@index([bookId])
  @@index([userId])
}

model Keyword {
  id      Int               @id @default(autoincrement())
  name    String            @unique
  userBooks UserBookKeyword[]
  
  @@map("keyword")
}

model UserBookKeyword {
  id          Int       @id @default(autoincrement())
  userBookId  Int       @map("user_book_id")
  keywordId   Int       @map("keyword_id")

  userBook    UserBook  @relation(fields: [userBookId], references: [id])
  keyword     Keyword   @relation(fields: [keywordId], references: [id])

  @@map("user_book_keyword")
  @@unique([userBookId, keywordId]) // 동일 키워드 중복 선택 방지
}





